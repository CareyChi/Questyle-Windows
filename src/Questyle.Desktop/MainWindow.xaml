<Window x:Class="Questyle.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Questyle.Desktop"
        xmlns:services="clr-namespace:Questyle.Desktop.Services"
        mc:Ignorable="d"
        Title="Questyle · Windows" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen" Background="Transparent" FontSize="14" Foreground="#252832" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#DEE1E7"/>
        <DropShadowEffect x:Key="ControlShadow" Color="#181B24" BlurRadius="4" ShadowDepth="1" Opacity=".12" RenderingBias="Performance"/>
        <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Border/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBox"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="CanContentScroll" Value="False"/>
            <Setter Property="local:SmoothScrolling.Enabled" Value="True"/>
        </Style>
        <local:ConnectedHeadphoneConverter x:Key="ConnectedHeadphone"/>
        <Style x:Key="HeadphoneItemStyle" TargetType="ListBoxItem">
            <Setter Property="local:StyleTransitions.Enabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Tag" Value="{Binding IsSelected, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="ItemBorder" local:StyleTransitions.Enabled="True" CornerRadius="9" Background="#F5F6F8" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#ECEEF3"/></Trigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#E8F2FF"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#AAC8EC"/></DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SavedHeadphoneItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource HeadphoneItemStyle}">
            <Setter Property="UseLayoutRounding" Value="False"/>
            <Setter Property="Height" Value="42.75"/>
            <Setter Property="Margin" Value="0,0,0,5.25"/>
            <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#181B24" BlurRadius="4" ShadowDepth="1" Opacity=".04" RenderingBias="Performance"/></Setter.Value></Setter>
            <Setter Property="Tag"><Setter.Value><MultiBinding Converter="{StaticResource ConnectedHeadphone}">
                <Binding Path="Address"/>
                <Binding Path="ConnectedHeadphoneAddress" RelativeSource="{RelativeSource AncestorType=Window}"/>
            </MultiBinding></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="local:StyleTransitions.Enabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#292D37"/><Setter Property="Padding" Value="17,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Effect="{StaticResource ControlShadow}" local:StyleTransitions.Enabled="True" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value=".75"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value=".55"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#C5CBD6"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="NavigationSurface" local:StyleTransitions.Enabled="True" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#282C36"/></Trigger>
                <Trigger Property="Tag" Value="Selected"><Setter Property="Background" Value="#343740"/><Setter Property="Foreground" Value="White"/></Trigger>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Selected"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="#3B3F49"/></MultiTrigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#454A56"/></Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="SavedHeadphoneTemplate">
            <Grid MinHeight="24">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Address}" FontSize="13" Foreground="#7B8290" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Button Grid.ColumnSpan="2" HorizontalAlignment="Right" Content="{Binding [删除], Source={x:Static services:UiLanguage.Current}}" Click="DeleteRememberedHeadphone" Background="#CA263D" Foreground="White" Padding="12,6" Height="32" Margin="0" VerticalAlignment="Center" Focusable="False">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Opacity" Value="0"/><Setter Property="IsHitTestVisible" Value="False"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="IsHitTestVisible" Value="True"/></DataTrigger></Style.Triggers>
                    </Style></Button.Style>
                </Button>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SearchHeadphoneTemplate">
            <Grid MinHeight="24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Address}" FontSize="13" Foreground="#7B8290" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/><Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent" Margin="1,3">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbSurface" local:StyleTransitions.Enabled="True" Background="#B9BEC7" CornerRadius="3"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#878E9B"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#6D7584"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StartupToggle" TargetType="CheckBox">
            <Setter Property="local:StyleTransitions.Enabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="Track" Effect="{StaticResource ControlShadow}" local:StyleTransitions.Enabled="True" Width="48" Height="28" CornerRadius="14" Background="#B9BEC7" BorderThickness="1" BorderBrush="{StaticResource ControlBorderBrush}">
                    <Ellipse x:Name="Knob" Width="22" Height="22" Fill="White" HorizontalAlignment="Left" Margin="2,0"><Ellipse.RenderTransform><TranslateTransform x:Name="KnobTranslation"/></Ellipse.RenderTransform></Ellipse>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#2077CE"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="KnobTranslation" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="KnobTranslation" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value=".8"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#181B24"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="CloseSurface" local:StyleTransitions.Enabled="True" CornerRadius="9" Background="Transparent" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
                    <ContentPresenter x:Name="CloseContent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="Tag" Value="Hover"><Setter TargetName="CloseSurface" Property="Background" Value="#FBE9ED"/><Setter Property="Foreground" Value="#CA263D"/></Trigger>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="Tag" Value="Hover"/></MultiTrigger.Conditions><Setter TargetName="CloseSurface" Property="Background" Value="#CA263D"/><Setter TargetName="CloseSurface" Property="BorderBrush" Value="#CA263D"/><Setter Property="Foreground" Value="White"/></MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="local:StyleTransitions.Enabled" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"/><Setter Property="Padding" Value="12,9"/><Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="InputSurface" local:StyleTransitions.Enabled="True" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#AEBACB"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#8DACD2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputSurface" Property="Opacity" Value=".4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="local:StyleTransitions.Enabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Padding" Value="10,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ItemSurface" local:StyleTransitions.Enabled="True" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#F0F3F7"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#E8F2FF"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="local:StyleTransitions.Enabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Padding" Value="12,7,38,7"/><Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid x:Name="ComboRoot" local:StyleTransitions.Enabled="True">
                    <ToggleButton x:Name="DropDownButton" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="ComboSurface" local:StyleTransitions.Enabled="True" CornerRadius="7" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1"/>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                    <Path x:Name="DropArrow" IsHitTestVisible="False" Data="M 0,0 L 4,4 L 8,0" Stroke="#7B8290" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Popup x:Name="PART_Popup" Placement="Bottom" local:StyleTransitions.DropDownOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" VerticalOffset="4" PopupAnimation="None">
                        <Border x:Name="DropDownSurface" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="White" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="4">
                            <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#AEBACB"/></Trigger>
                    <Trigger Property="IsDropDownOpen" Value="True"><Setter Property="BorderBrush" Value="#8DACD2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#F2F3F5"/><Setter TargetName="ComboRoot" Property="Opacity" Value=".65"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="local:StyleTransitions.Enabled" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"/><Setter Property="Margin" Value="0,4,0,18"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border x:Name="CheckSurface" Effect="{StaticResource ControlShadow}" local:StyleTransitions.Enabled="True" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource ControlBorderBrush}" Background="White" VerticalAlignment="Center">
                        <Path x:Name="CheckMark" local:StyleTransitions.Enabled="True" Data="M 3,8 L 6,11 L 12,4" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0"/>
                    </Border>
                    <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#64768F"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="#2077CE"/><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#2077CE"/><Setter TargetName="CheckMark" Property="Opacity" Value="1"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="CheckSurface" Property="Opacity" Value=".65"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="WindowSurface" Background="Transparent">
        <Border x:Name="WindowFrame" Margin="0" CornerRadius="24" BorderThickness="1" BorderBrush="#181B24" Background="#181B24" SnapsToDevicePixels="False">
            <AdornerDecorator><Grid x:Name="FrameContent">
                <Grid x:Name="Root" Background="#181B24"/>
                <Grid x:Name="SearchOverlay" Background="#40101828" Visibility="Collapsed"/>
                <Grid x:Name="PeqExportOverlay" Background="#40101828" Visibility="Collapsed"/>
                <Border x:Name="PeqNotice" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,64,20,0" MaxWidth="560" Padding="16,10" CornerRadius="7" Background="White" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" Effect="{StaticResource ControlShadow}" IsHitTestVisible="False" Panel.ZIndex="20">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid x:Name="PeqNoticeIcon" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse x:Name="PeqNoticeCircle" Fill="#4B9B66"/>
                            <Path x:Name="PeqNoticeMark" Data="M 5.5,10 L 8.5,13 L 14.5,7" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <TextBlock x:Name="PeqNoticeText" Grid.Column="1" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid></AdornerDecorator>
        </Border>
    </Grid>
</Window>
